{
  "version": 1,
  "piGatewayExtension": "../../tools/pi-claudex-provider/index.ts",
  "mainProviders": ["codex", "codex-spark", "grok", "fugu", "ollama-glm-5-2", "opencode-go", "command-code"],
  "providers": [
    {
      "id": "codex",
      "agent": "claudex-gpt",
      "defaultModel": "gpt-5.6-luna",
      "subagentModel": "gpt-5.6-luna",
      "piProvider": "openai-codex",
      "piModel": "gpt-5.6-luna",
      "effort": "max",
      "maxContextTokens": 110000,
      "enabled": true,
      "usageProvider": "codex",
      "modelPrefixes": [
        "gpt"
      ],
      "selectableModels": [
        "gpt-5.6-terra"
      ],
      "backend": "codex-app-server",
      "webSearchMode": "codex-native"
    },
    {
      "id": "codex-spark",
      "agent": "claudex-gpt-spark",
      "defaultModel": "gpt-5.3-codex-spark",
      "subagentModel": "gpt-5.3-codex-spark",
      "effort": "xhigh",
      "maxContextTokens": 110000,
      "enabled": true,
      "usageProvider": "codex",
      "usageWeeklyWindowId": "codex-spark-weekly",
      "modelPrefixes": [
        "gpt-5.3-codex-spark"
      ],
      "backend": "codex-app-server",
      "webSearchMode": "codex-native"
    },
    {
      "id": "fugu",
      "agent": "claudex-fugu",
      "defaultModel": "fugu",
      "piProvider": "sakana",
      "piModel": "fugu",
      "effort": "high",
      "maxContextTokens": 1000000,
      "enabled": true,
      "usageProvider": "sakana",
      "modelProvider": "sakana",
      "modelCatalogJson": "~/.codex/fugu.json",
      "modelPrefixes": [
        "fugu"
      ],
      "backend": "codex-app-server",
      "webSearchMode": "delegate-ccr"
    },
    {
      "id": "ollama-glm-5-2",
      "agent": "claudex-ollama-glm-5-2",
      "defaultModel": "glm-5.2:cloud",
      "subagentModel": "glm-5.2:cloud",
      "piProvider": "ollama-cloud",
      "piModel": "glm-5.2",
      "piExtensions": [
        "~/.pi/agent/npm/node_modules/pi-ollama-cloud/index.ts"
      ],
      "effort": "max",
      "enabled": true,
      "usageProvider": "ollama",
      "modelProvider": "ollama",
      "modelCatalogJson": "~/.codex/fugu.json",
      "modelPrefixes": [
        "glm-"
      ],
      "backend": "codex-app-server",
      "webSearchMode": "delegate-ccr"
    },
    {
      "id": "grok",
      "agent": "claudex-grok",
      "defaultModel": "grok-4.6",
      "effort": "high",
      "maxContextTokens": 500000,
      "enabled": true,
      "usageProvider": "grok",
      "modelPrefixes": [
        "grok"
      ],
      "backend": "grok-acp",
      "webSearchMode": "acp-native"
    },
    {
      "id": "qwen",
      "agent": "claudex-qwen",
      "defaultModel": "qwen3.8-max-preview",
      "effort": "high",
      "maxConcurrency": 3,
      "enabled": true,
      "usageProvider": "qwencloud",
      "modelPrefixes": [
        "qwen3"
      ],
      "backend": "configured-acp",
      "webSearchMode": "disabled",
      "acp": {
        "program": "/usr/bin/env",
        "arguments": [
          "QWEN_WEB_FETCH_PROCESSING_TIMEOUT_MS=8000",
          "qwen",
          "--acp",
          "--approval-mode",
          "yolo",
          "--model",
          "{model}"
        ]
      }
    },
    {
      "id": "opencode-go",
      "agent": "claudex-deepseek-pro",
      "defaultModel": "opencode-go/deepseek-v4-pro",
      "subagentModel": "opencode-go/deepseek-v4-pro",
      "effort": "max",
      "enabled": true,
      "usageProvider": "opencodego",
      "requestBudget": {
        "estimatedRequests": 3450,
        "windowMinutes": 300,
        "usageWindow": "primary"
      },
      "modelPrefixes": [
        "opencode-go/deepseek-v4-pro"
      ],
      "backend": "configured-acp",
      "webSearchMode": "delegate-mcp",
      "acp": {
        "program": "opencode",
        "arguments": [
          "acp"
        ]
      }
    },
    {
      "id": "opencode-go-flash",
      "agent": "claudex-deepseek-flash",
      "defaultModel": "opencode-go/deepseek-v4-flash",
      "subagentModel": "opencode-go/deepseek-v4-flash",
      "effort": "max",
      "enabled": true,
      "usageProvider": "opencodego",
      "requestBudget": {
        "estimatedRequests": 31650,
        "windowMinutes": 300,
        "usageWindow": "primary"
      },
      "modelPrefixes": [
        "opencode-go/deepseek-v4-flash"
      ],
      "backend": "configured-acp",
      "webSearchMode": "delegate-mcp",
      "acp": {
        "program": "opencode",
        "arguments": [
          "acp"
        ]
      }
    },
    {
      "id": "opencode-go-luna",
      "agent": "claudex-opencode-gpt",
      "defaultModel": "opencode-go/gpt-5.6-luna",
      "subagentModel": "opencode-go/gpt-5.6-luna",
      "effort": "max",
      "enabled": true,
      "usageProvider": "opencodego",
      "requestBudget": {
        "estimatedRequests": 31650,
        "windowMinutes": 300,
        "usageWindow": "primary"
      },
      "modelPrefixes": [
        "opencode-go/gpt-5.6-luna"
      ],
      "backend": "configured-acp",
      "webSearchMode": "delegate-mcp",
      "acp": {
        "program": "opencode",
        "arguments": [
          "acp"
        ]
      }
    },
    {
      "id": "cursor",
      "agent": "claudex-cursor",
      "defaultModel": "auto",
      "subagentModel": "auto",
      "piProvider": "cursor",
      "piModel": "auto",
      "piExtensions": [
        "../../tools/pi-my-cursor-provider/index.ts"
      ],
      "effort": "high",
      "maxContextTokens": 200000,
      "enabled": true,
      "usageProvider": "cursor",
      "modelPrefixes": [
        "auto"
      ],
      "backend": "configured-acp",
      "webSearchMode": "acp-native",
      "acp": {
        "program": "cursor-agent",
        "arguments": [
          "--model",
          "{model}",
          "--yolo",
          "acp"
        ]
      }
    },
    {
      "id": "cline-deepseek-flash",
      "agent": "claudex-cline-deepseek-flash",
      "defaultModel": "cline-pass/deepseek-v4-flash",
      "subagentModel": "cline-pass/deepseek-v4-flash",
      "piProvider": "clinepass",
      "piModel": "cline-pass/deepseek-v4-flash",
      "piExtensions": [
        "../../tools/pi-my-clinepass-provider/index.ts"
      ],
      "effort": "xhigh",
      "enabled": true,
      "usageProvider": "clinepass",
      "modelPrefixes": [
        "cline-pass/deepseek-v4-flash"
      ],
      "backend": "configured-acp",
      "webSearchMode": "acp-native",
      "acp": {
        "program": "cline",
        "arguments": [
          "--auto-approve",
          "true",
          "--thinking",
          "{effort}",
          "-P",
          "cline-pass",
          "-m",
          "{model}",
          "--acp"
        ]
      }
    },
    {
      "id": "command-code",
      "agent": "claudex-command-code-muse-spark-1-2-contributor",
      "defaultModel": "meta/muse-spark-1.2-contributor",
      "subagentModel": "meta/muse-spark-1.2-contributor",
      "effort": "high",
      "maxConcurrency": 2,
      "enabled": true,
      "usageProvider": "commandcode",
      "modelPrefixes": [
        "meta/muse-spark"
      ],
      "backend": "configured-acp",
      "webSearchMode": "acp-native",
      "acp": {
        "program": "command-code-acp",
        "arguments": [
          "--model",
          "{model}",
          "--effort",
          "{effort}"
        ]
      }
    }
  ],
  "fallback": {
    "agent": "claudex-sonnet",
    "model": "claude-sonnet-5",
    "effort": "high"
  },
  "nativeWorkers": [
    {
      "agent": "claudex-haiku-search",
      "model": "claude-haiku-4-5",
      "effort": "max",
      "usageProvider": "claude"
    },
    {
      "agent": "claudex-sonnet",
      "model": "claude-sonnet-5",
      "effort": "high",
      "usageProvider": "claude"
    }
  ],
  "webSearch": {
    "fallbackProviders": ["codex-spark", "codex"]
  },
  "advisor": {
    "agent": "custom-advisor",
    "model": "claude-opus-5",
    "effort": "medium"
  }
}
