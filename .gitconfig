[user]
	name = kkk4oru
	email = kaoru+git@teadea.net
[merge]
	ff = false
	tool = vimdiff
	conflictstyle = diff3
[pull]
	ff = only
[core]
	ignorecase = false
	quotepath = false
	safecrlf = false
	autocrlf = false
	excludesFile = ~/.gitignore_global
[pager]
	branch = cat
[log]
	date = iso-local
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[diff]
	tool = vimdiff
[difftool]
	prompt = false
[mergetool]
	prompt = false
; Per-machine overrides (signing key, GPG path, maintenance repos, etc.)
; This file is intentionally NOT tracked by the dotfiles repo.
[include]
	path = ~/.gitconfig.local
[url "git@github.com:"]
	insteadOf = https://github.com/
; Config-based hooks require Git 2.54+ (Homebrew git). Apple Xcode Git ignores these.
[hook "staged-whitespace"]
	event = pre-commit
	command = git diff --cached --check
[hook "dotfiles-pre-commit"]
	event = pre-commit
	command = ~/.local/bin/dotfiles-git-quality pre-commit
[hook "dotfiles-pre-push"]
	event = pre-push
	command = ~/.local/bin/dotfiles-git-quality pre-push

