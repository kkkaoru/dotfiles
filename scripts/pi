#!/bin/bash
# Start oMLX on demand when this pi invocation will talk to the local provider.

set -euo pipefail

find_node_binary() {
  for candidate in \
    "${PI_NODE_BINARY:-}" \
    "$(command -v node 2>/dev/null || true)" \
    /opt/homebrew/bin/node \
    /usr/local/bin/node \
    "${HOME}/.local/share/mise/installs/node/latest/bin/node" \
    "${HOME}"/.local/share/mise/installs/node/*/bin/node; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  return 1
}

NODE_BINARY="$(find_node_binary || true)"
if [ -z "$NODE_BINARY" ]; then
  echo "pi wrapper: could not find node; install Node with mise or set PI_NODE_BINARY" >&2
  exit 127
fi
SCRIPT_PATH="$("$NODE_BINARY" -e 'console.log(require("node:fs").realpathSync(process.argv[1]))' "$0")"
SCRIPT_DIR="${SCRIPT_PATH%/*}"
REAL_PI=""
for candidate in "${HOME}/.bun/bin/pi" /opt/homebrew/bin/pi; do
  if [ -x "$candidate" ] && [ "$candidate" != "$0" ]; then
    REAL_PI="$candidate"
    break
  fi
done
if [ -z "$REAL_PI" ]; then
  echo "pi wrapper: could not find the real pi binary" >&2
  exit 127
fi

OMLX_CLI="${OMLX_CLI:-/Applications/oMLX.app/Contents/MacOS/omlx-cli}"
needs_omlx=0
detect_omlx_requirement() {
  case "${1-}" in
    install|remove|uninstall|update|list|config|auth|--list-models|--help|-h|--version|-v)
      return
      ;;
  esac

  provider="${PI_PROVIDER:-}"
  model="${PI_MODEL:-}"
  provider_from_cli=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --provider)
        provider="${2-}"
        provider_from_cli=1
        if [ "$#" -ge 2 ]; then
          shift 2
        else
          shift
        fi
        continue
        ;;
      --provider=*)
        provider="${1#*=}"
        provider_from_cli=1
        ;;
      --model)
        model="${2-}"
        if [ "$#" -ge 2 ]; then
          shift 2
        else
          shift
        fi
        continue
        ;;
      --model=*)
        model="${1#*=}"
        ;;
    esac
    shift
  done

  # A provider-qualified model is an explicit selection and wins over the
  # ambient provider. Otherwise use pi's configured default provider.
  if [ "$provider_from_cli" -eq 0 ] && [[ "$model" == omlx/* ]]; then
    provider="omlx"
  elif [ -z "$provider" ]; then
    for settings_file in \
      "${PWD}/.pi/settings.json" \
      "${PI_CODING_AGENT_DIR:-${HOME}/.pi/agent}/settings.json"; do
      if [ ! -r "$settings_file" ]; then
        continue
      fi
      configured_provider="$(sed -nE 's/.*"defaultProvider"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "$settings_file" | head -n 1)"
      if [ -n "$configured_provider" ]; then
        provider="$configured_provider"
        break
      fi
    done
  fi

  if [ "$provider" = "omlx" ]; then
    needs_omlx=1
  fi
}

# Shifts inside the function only affect its local positional parameters, so
# the wrapper's original "$@" remains intact even on Bash 3.2 with `set -u`.
detect_omlx_requirement "$@"

if [ "$needs_omlx" -eq 1 ] && [ ! -x "$OMLX_CLI" ]; then
  # Pi remains usable with another provider when the optional local oMLX
  # installation is absent.
  needs_omlx=0
fi

if [ "$needs_omlx" -eq 1 ]; then
  ensure_omlx=""
  for candidate in "$SCRIPT_DIR/ensure-omlx" "$SCRIPT_DIR/ensure-omlx.sh"; do
    if [ -x "$candidate" ]; then
      ensure_omlx="$candidate"
      break
    fi
  done
  if [ -n "$ensure_omlx" ]; then
    "$ensure_omlx" || true
  fi
fi

REAL_PI_RESOLVED="$("$NODE_BINARY" -e 'console.log(require("node:fs").realpathSync(process.argv[1]))' "$REAL_PI")"
case "$REAL_PI_RESOLVED" in
  */@earendil-works/pi-coding-agent/dist/bundle/cli.js|*/@earendil-works/pi-coding-agent/dist/cli.js)
    PACKAGE_ROOT="${REAL_PI_RESOLVED%%/dist/*}"
    PATCH_MODULE="$SCRIPT_DIR/pi-compaction-singleflight.mjs"
    UNBUNDLED_CLI="$PACKAGE_ROOT/dist/cli.js"
    if [ -f "$PATCH_MODULE" ] && [ -f "$UNBUNDLED_CLI" ]; then
      PI_CODING_AGENT_PACKAGE_ROOT="$PACKAGE_ROOT" \
        exec "$NODE_BINARY" --import "$PATCH_MODULE" "$UNBUNDLED_CLI" "$@"
    fi
    ;;
esac

exec "$REAL_PI" "$@"
