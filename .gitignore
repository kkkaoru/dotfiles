!.claude/skills/git-commit-by-feature
!.claude/skills/python-coding-rules
!.claude/skills/rust-coding-rules
!.claude/skills/typescript-coding-rules


# Pi is repository-managed, but only a small allowlist is tracked. Ignore
# everything else so new credential or state files cannot leak into git.
.pi/**
!.pi/agent/
!.pi/agent/models.json
!.pi/agent/settings.json
!.pi/agent/themes/
!.pi/agent/themes/**

# Grok keeps sessions, auth, caches, and binaries beside config. Track only
# the files this repository manages; ignore everything else so credentials
# and machine-local state cannot leak into git.
.grok/**
!.grok/config.toml
!.grok/pager.toml
!.grok/lsp.json
!.grok/hooks/
!.grok/hooks/**
!.grok/skills/
!.grok/skills/**

