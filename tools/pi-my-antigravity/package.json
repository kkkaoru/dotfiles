{
  "name": "@kkkaoru/pi-my-antigravity",
  "version": "0.1.0",
  "private": true,
  "description": "Antigravity (subscription) provider for Pi Coding Agent, modeled on the official agy CLI wire format",
  "keywords": [
    "antigravity",
    "gemini",
    "pi-extension",
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check .",
    "smoke": "bun run check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
