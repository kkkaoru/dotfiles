{
  "name": "@kkkaoru/executor-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "start": "bun run cli.mjs",
    "tsc": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --coverage && bun run test:oauth && bun run test:setup",
    "test:oauth": "bash ../../scripts/executor-cloudflare-auth.test.sh",
    "test:setup": "bash ../../scripts/setup-executor.test.sh",
    "check": "bun run tsc && bun run lint && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/bun": "1.4.5",
    "@vitest/coverage-v8": "5.1.2",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
