{
  "version": 1,
  "mainProvider": "codex",
  "providers": [
    {
      "id": "codex",
      "agent": "claudex-gpt",
      "defaultModel": "gpt-5.6-sol",
      "effort": "high",
      "enabled": true,
      "usageProvider": "codex",
      "modelPrefixes": ["gpt"],
      "backend": "codex-app-server"
    },
    {
      "id": "grok",
      "agent": "claudex-grok",
      "defaultModel": "grok-4.5",
      "effort": "high",
      "enabled": true,
      "usageProvider": "grok",
      "modelPrefixes": ["grok"],
      "backend": "grok-acp"
    },
    {
      "id": "qwen",
      "agent": "claudex-qwen",
      "defaultModel": "qwen3.8-max-preview",
      "effort": "high",
      "enabled": true,
      "usageProvider": "qwen",
      "modelPrefixes": ["qwen"],
      "backend": "configured-acp",
      "acp": {
        "program": "qwen",
        "arguments": ["--acp", "--model", "{model}"]
      }
    }
  ],
  "fallback": {
    "agent": "claudex-sonnet",
    "model": "claude-sonnet-5",
    "effort": "high"
  }
}
