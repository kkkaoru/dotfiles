{
  "version": 1,
  "mainProviders": ["codex", "codex-spark", "grok", "fugu", "ollama-glm-5-2", "opencode-go"],
  "providers": [
    {
      "id": "codex",
      "agent": "claudex-gpt",
      "defaultModel": "gpt-5.6-luna",
      "subagentModel": "gpt-5.6-luna",
      "effort": "max",
      "maxContextTokens": 110000,
      "enabled": true,
      "usageProvider": "codex",
      "modelPrefixes": [
        "gpt"
      ],
      "backend": "codex-app-server",
      "webSearchMode": "codex-native"
    },
    {
      "id": "codex-spark",
      "agent": "claudex-gpt-spark",
      "defaultModel": "gpt-5.3-codex-spark",
      "subagentModel": "gpt-5.3-codex-spark",
      "effort": "xhigh",
      "maxContextTokens": 110000,
      "enabled": true,
      "usageProvider": "codex",
      "modelPrefixes": [
        "gpt-5.3-codex-spark"
      ],
      "backend": "codex-app-server",
      "webSearchMode": "codex-native"
    },
    {
      "id": "fugu",
      "agent": "claudex-fugu",
      "defaultModel": "fugu",
      "effort": "high",
      "maxContextTokens": 1000000,
      "enabled": true,
      "usageProvider": "sakana",
      "modelProvider": "sakana",
      "modelCatalogJson": "~/.codex/fugu.json",
      "modelPrefixes": [
        "fugu"
      ],
      "backend": "codex-app-server",
      "webSearchMode": "delegate-ccr"
    },
    {
      "id": "ollama-glm-5-2",
      "agent": "claudex-ollama-glm-5-2",
      "defaultModel": "glm-5.2:cloud",
      "subagentModel": "glm-5.2:cloud",
      "effort": "max",
      "enabled": true,
      "usageProvider": "ollama",
      "modelProvider": "ollama",
      "modelCatalogJson": "~/.codex/fugu.json",
      "modelPrefixes": [
        "glm-"
      ],
      "backend": "codex-app-server",
      "webSearchMode": "delegate-ccr"
    },
    {
      "id": "grok",
      "agent": "claudex-grok",
      "defaultModel": "grok-4.5",
      "effort": "high",
      "enabled": true,
      "usageProvider": "grok",
      "modelPrefixes": [
        "grok"
      ],
      "backend": "grok-acp",
      "webSearchMode": "acp-native"
    },
    {
      "id": "qwen",
      "agent": "claudex-qwen",
      "defaultModel": "qwen3.8-max-preview",
      "effort": "high",
      "maxConcurrency": 3,
      "enabled": true,
      "usageProvider": "qwen",
      "modelPrefixes": [
        "qwen"
      ],
      "backend": "configured-acp",
      "webSearchMode": "disabled",
      "acp": {
        "program": "/usr/bin/env",
        "arguments": [
          "QWEN_WEB_FETCH_PROCESSING_TIMEOUT_MS=8000",
          "qwen",
          "--acp",
          "--approval-mode",
          "yolo",
          "--model",
          "{model}"
        ]
      }
    },
    {
      "id": "opencode-go",
      "agent": "claudex-deepseek",
      "defaultModel": "opencode-go/deepseek-v4-pro",
      "effort": "max",
      "enabled": true,
      "usageProvider": "opencodego",
      "requestBudget": {
        "estimatedRequests": 3450,
        "windowMinutes": 300,
        "usageWindow": "primary"
      },
      "modelPrefixes": [
        "opencode-go/"
      ],
      "backend": "configured-acp",
      "webSearchMode": "delegate-mcp",
      "acp": {
        "program": "opencode",
        "arguments": [
          "acp"
        ]
      }
    }
  ],
  "fallback": {
    "agent": "claudex-sonnet",
    "model": "claude-sonnet-5",
    "effort": "high"
  },
  "nativeWorkers": [
    {
      "agent": "claudex-haiku-search",
      "model": "claude-haiku-4-5",
      "effort": "max"
    }
  ],
  "webSearch": {
    "fallbackProviders": ["codex-spark", "codex"]
  },
  "advisor": {
    "agent": "custom-advisor",
    "model": "claude-fable-5",
    "effort": "xhigh"
  }
}
