#!/bin/sh
# Use the CLI shipped with the Homebrew cask; do not install a second runtime.
set -eu
# Resolve this wrapper even when invoked through ~/.local/bin/executor.
script="$0"
while [ -L "$script" ]; do
  dir=$(CDPATH= cd -P "$(dirname "$script")" && pwd)
  target=$(readlink "$script")
  case "$target" in
    /*) script="$target" ;;
    *) script="$dir/$target" ;;
  esac
done
repo=$(CDPATH= cd -P "$(dirname "$script")/.." && pwd)
# The daemon derives its catalog tenant from this path, not the database path.
# Preserve an explicit override for callers intentionally using another scope.
EXECUTOR_SCOPE_DIR="${EXECUTOR_SCOPE_DIR:-$repo}"
export EXECUTOR_SCOPE_DIR
binary="/Applications/Executor.app/Contents/Resources/executor/executor"
if [ ! -x "$binary" ]; then
  printf '%s\n' 'Executor Desktop is missing. Install it with: brew install --cask executor' >&2
  exit 127
fi
# No sync daemon: short-lived hooks surround ordinary tool use. Never recurse
# into sync's own CLI calls, or intercept daemon/service/MCP lifecycle commands.
sync_target=local
for argument in "$@"; do
  case "$argument" in
    --scope|--scope=*|--base-url|--base-url=*|--server|--server=*) sync_target=explicit ;;
  esac
done
case "${1:-}" in
  call|tools|resume)
    if [ "$sync_target" = local ] && [ "${EXECUTOR_SYNC_ACTIVE:-0}" != 1 ] && [ "$EXECUTOR_SCOPE_DIR" = "$repo" ] &&
       [ -z "${EXECUTOR_DATA_DIR:-}" ] && [ -z "${EXECUTOR_KEYCHAIN_SERVICE_NAME:-}" ] &&
       [ -f "$repo/.executor/sync.json" ] && [ -d "$repo/tools/executor-sync/node_modules" ] &&
       command -v bun >/dev/null 2>&1; then
      EXECUTOR_SYNC_ACTIVE=1 bun "$repo/tools/executor-sync/src/cli.ts" hook before >/dev/null ||
        printf '%s\n' 'Executor settings sync unavailable; continuing locally.' >&2
      if "$binary" "$@"; then status=0; else status=$?; fi
      EXECUTOR_SYNC_ACTIVE=1 bun "$repo/tools/executor-sync/src/cli.ts" hook after >/dev/null ||
        printf '%s\n' 'Executor settings sync unavailable; local result preserved.' >&2
      exit "$status"
    fi
    ;;
esac
exec "$binary" "$@"
