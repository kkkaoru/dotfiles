{
  "name": "@kkkaoru/executor-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./pi.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "start": "bun run cli.mjs",
