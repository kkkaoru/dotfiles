{
  "lastChangelogVersion": "0.85.1",
  "theme": "dracula",
  "tuiMode": "fullscreen",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 65536,
    "keepRecentTokens": 12000
  },
  "pi-effort-manager": {
    "dynamicDefault": true,
    "startEffort": "medium",
    "endEffort": "xhigh",
    "compactionEffort": "max",
    "compactionResetInterval": 1,
    "compactionResetEffort": "xhigh",
    "progressTextOnCompaction": true,
    "progressTextOnEffortChange": true,
    "rampStartRatio": 0.6
  },
  "skills": [
    "!agmsg",
    "!ctx-agent-history-search"
  ],
  "packages": [
    "./packages/pi-effort-manager",
    "./packages/pi-my-clinepass-provider",
    "npm:pi-ollama-cloud",
    "./packages/pi-my-cursor-provider",
    "./packages/pi-my-devin-cli-provider",
    "./packages/pi-claudex-provider",
    "./packages/pi-lazy-external-extensions",
    "./packages/executor-skills",
    "npm:@ogulcancelik/pi-herdr"
  ]
}