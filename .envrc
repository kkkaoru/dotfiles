dotenv

# Keep the remote Claude endpoint and injected headers out of the directory
# environment. Plain claude may still use a user's explicit API key/token,
# while claudex injects its loopback endpoint and local token only into its
# child process. A remote gateway must be opted into on the explicit command
# that needs it; never make it the default for every command in this repository.
unset ANTHROPIC_BASE_URL ANTHROPIC_CUSTOM_HEADERS
