{
  "name": "@kkkaoru/executor-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "tsc": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --coverage && bun run test:hooks",
    "test:hooks": "bash ../../scripts/executor-sync-hooks.test.sh",
    "smoke": "bun run src/smoke.ts && bun run src/secure-smoke.ts",
    "check": "bun run tsc && bun run lint && bun run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@libsql/client": "0.15.15",
    "@napi-rs/keyring": "1.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "1.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
