{
  "name": "@kkkaoru/pi-goal-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --coverage",
    "smoke": "bun run smoke.mjs",
    "smoke:recovery": "bun run recovery-smoke.mjs",
    "check": "bun run tsc && bun run lint && bun run test"
  },
  "dependencies": {
    "typebox": "1.4.7",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-coding-agent": "1.6.1",
    "@types/node": "26.6.11",
    "@vitest/coverage-v8": "5.1.2",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.4"
  }
}
