node_modules
__pycache__/
*.py[cod]
!.gitkeep

# Keep only Serena's repository configuration in git. Runtime caches and local
# overrides remain local to each checkout.
.serena/*
!.serena/project.yml

# Rust target directories can be nested when a verification lane supplies a
# relative CARGO_TARGET_DIR; keep all generated build artifacts out of git.
**/target/
# llvm-cov and sanitizer runs leave these transient artifacts outside target.
*.profraw
*.profdata
.claude/skills/claudex-routing/.coverage
rust_out
coverage_out/
.hyper_plugins/cache/*
!.hyper_plugins/cache/.gitkeep
.ssh/*
!.ssh/.gitkeep
!.ssh/init.sh
.env

# GPG
.gnupg/
*.gpg
*.asc
*.key
*.pem

.claude/*
!.claude/.gitkeep
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/agents/
!.claude/agents/**
!.claude/commands
!.claude/commands/*
!.claude/hooks/
